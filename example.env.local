# Use your own backend. HTTPS is required in production.
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
# Generate a unique secret for each environment: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002
# Public marketing website (used for "Back to Training" links)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# Role dashboards (used to hand off a new account to the app that serves its role)
NEXT_PUBLIC_OWNER_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_BOOKKEEPER_DASHBOARD_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3003
